<%- include("partials/header"); -%>
<section class="form-page">
  <a class="back-link" href="/">← Back to stories</a>
  <p class="eyebrow">YOUR WORDS, YOUR GAME</p><h1>Write a <em>story.</em></h1>
  <form class="editor-form" action="/compose" method="post">
    <label for="postTitle">Headline</label>
    <input id="postTitle" type="text" name="postTitle" placeholder="Give your story a title…" maxlength="140" required>
    <label for="postBody">Your story</label>
    <textarea id="postBody" name="postBody" rows="12" placeholder="Start writing…" required></textarea>
    <button class="button button-dark" type="submit">Publish story <span>↗</span></button>
  </form>
</section>
<%- include("partials/footer"); -%>
